; American Empire P4 Godot World Explorer. Verified source bundle required.
config_version=5

[application]
config/name="American Empire - World Explorer P4"
run/main_scene="res://scenes/world_explorer.tscn"
config/description="The Quiet Accession canon graph and P3 counterfactual viewer"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
